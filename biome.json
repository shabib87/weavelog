{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["src/**/*.ts", "tests/**/*.ts", "biome.json", "package.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "warn",
        "useAwait": "warn",
        "noAsyncPromiseExecutor": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useNamingConvention": {
          "level": "warn",
          "options": {
            "strictCase": false,
            "conventions": [
              { "selector": { "kind": "typeLike" }, "formats": ["PascalCase"] },
              { "selector": { "kind": "enumMember" }, "formats": ["CONSTANT_CASE"] },
              { "selector": { "kind": "variable" }, "formats": ["camelCase", "CONSTANT_CASE"] },
              { "selector": { "kind": "classMember" }, "formats": ["camelCase", "CONSTANT_CASE"] }
            ]
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "warn",
        "noMisusedPromises": "warn"
      }
    }
  },
  "json": {
    "formatter": {
      "lineWidth": 100
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
