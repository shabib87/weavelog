#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

EXCLUDES=(
  ':(exclude)backlog'
  ':(exclude)NOTICE'
  ':(exclude)ATTRIBUTION.md'
  ':(exclude)README.md'
  ':(exclude)CHANGELOG.md'
  ':(exclude)scripts/privacy-audit'
  ':(exclude)scripts/privacy-audit-strings.txt'
  ':(exclude)tests/payload/privacy.test.ts'
)

HITS="$(git grep -n -f scripts/privacy-audit-strings.txt -- . "${EXCLUDES[@]}" || true)"

if [ -n "$HITS" ]; then
  echo "privacy-audit: FAILED — personal strings found in tracked files:"
  echo "$HITS"
  exit 1
fi

echo "privacy-audit: clean (no personal strings in tracked files)"
