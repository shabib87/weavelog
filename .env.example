# flightlead live-root configuration (copy to .env at the live root; never commit .env)
# FLIGHTLEAD_HOME: where flightlead materializes its live root (default ~/.agents)
FLIGHTLEAD_HOME=$HOME/.agents
# FLIGHTLEAD_CONFIG_HOME: opencode config dir (default ~/.config/opencode)
FLIGHTLEAD_CONFIG_HOME=$HOME/.config/opencode